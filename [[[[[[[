local function RemoveESP(target)
    if ESPObjects[target] then
        ESPObjects[target]:Destroy()
        ESPObjects[target] = nil
    end
end

local function CreateESP(target)
    if target == Player or not ESPEnabled then return end

    RemoveESP(target)

    local character = target.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    local billboard = Create("BillboardGui", {
        Name = "VYRE_ESP",
        Adornee = head,
        Size = UDim2.fromOffset(190, 48),
        StudsOffset = Vector3.new(0, 2.8, 0),
        AlwaysOnTop = true,
        MaxDistance = ESPDistance,
        Enabled = true
    }, PlayerGui)

    local text = Create("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = target.Name,
        TextColor3 = ESPColor,
        TextStrokeTransparency = 0.2,
        TextStrokeColor3 = Color3.new(0, 0, 0),
        Font = Enum.Font.GothamBold,
        TextSize = 12
    }, billboard)

    ESPObjects[target] = billboard

    local function Update()
        if not billboard.Parent or not character.Parent then return end

        billboard.MaxDistance = ESPDistance

        local tool = character:FindFirstChildOfClass("Tool")
        local toolName = tool and tool.Name or "Sin herramienta"

        local mode = ESPMode or "both"

        if mode == "name" then
            text.Text = target.Name
        elseif mode == "tool" then
            text.Text = toolName
        else
            text.Text = target.Name .. "\n" .. toolName
        end

        text.TextColor3 = ESPColor
    end

    Update()
end

ESPMode = "both"

local function RefreshESP()
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player then
            local character = target.Character
            local head = character and character:FindFirstChild("Head")

            if head then
                local current = ESPObjects[target]

                if not current or current.Adornee ~= head then
                    CreateESP(target)
                else
                    current.MaxDistance = ESPDistance

                    local text = current:FindFirstChildOfClass("TextLabel")
                    if text then
                        local tool = character:FindFirstChildOfClass("Tool")
                        local toolName = tool and tool.Name or "Sin herramienta"

                        if ESPMode == "name" then
                            text.Text = target.Name
                        elseif ESPMode == "tool" then
                            text.Text = toolName
                        else
                            text.Text = target.Name .. "\n" .. toolName
                        end

                        text.TextColor3 = ESPColor
                    end
                end
            else
                RemoveESP(target)
            end
        end
    end
end

