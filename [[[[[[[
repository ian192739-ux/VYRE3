--====================================================
-- SISTEMA DE AUTO APUNTADO
--====================================================

local function GetClosestPlayer()
    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local closest = nil
    local shortest = FOVSize

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player and target.Character then
            local character = target.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local head = character:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local distance = (
                    camera.CFrame.Position - head.Position
                ).Magnitude

                if distance <= AimRange then
                    local screenPos, visible =
                        camera:WorldToViewportPoint(head.Position)

                    if visible and screenPos.Z > 0 then
                        local screenDistance = (
                            Vector2.new(screenPos.X, screenPos.Y) - center
                        ).Magnitude

                        if screenDistance <= shortest then
                            shortest = screenDistance
                            closest = head
                        end
                    end
                end
            end
        end
    end

    return closest
end

RunService:BindToRenderStep(
    "VYRE_AIM",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        local camera = workspace.CurrentCamera

        FOVCircle.Visible =
            Main.Parent ~= nil
            and not HubHidden
            and ShowFOV
            and AimEnabled

        FOVCircle.Size = UDim2.fromOffset(
            FOVSize * 2,
            FOVSize * 2
        )

        if not AimEnabled or not RightClickHeld then
            return
        end

        if not camera then return end

        local target = GetClosestPlayer()

        if target then
            local desired = CFrame.lookAt(
                camera.CFrame.Position,
                target.Position
            )

            local alpha = math.clamp(Precision / 100, 0.01, 1)

            camera.CFrame = camera.CFrame:Lerp(desired, alpha)
        end
    end
)

